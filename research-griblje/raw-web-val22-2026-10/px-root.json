    <title>SURS &ndash; Spletna stran trenutno ni na voljo</title>
    <style>
        body {
            background-color: #FFFFFF; 
            font-family: Arial, sans-serif; 
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        .banner {
            background-color: #007FAD; 
            padding: 10px 20px; 
            display: flex;
            align-items: center;
        }
        .logo {
            height: 37px; 
        }
        .content {
			font-size:20px;
            margin-top: 40px;
            padding: 20px;
            text-align: center;
        }
        .small-image {
            margin-top: 40px;
            width: 100%;
            max-width: 800px;
            height: auto; 
        }

        /* Responsive Styles */
        @media (max-width: 768px) {
            .banner {
                padding: 10px;
            }
            .content {
                margin-top: 20px;
                padding: 10px;
            }
        }
		
		
		.nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
}

.nav li {
    display: inline;
}
.nav a:hover {
    text-decoration: underline;
}

.nav a {
    color: white;
    padding: 0 10px;
    text-decoration: none;
    display: inline-block;
    line-height: 37px; /* Align with logo height */
}

/* To align the nav to the right */
.nav.navbar-nav.surs-nav-right {
    margin-left: auto;
}

/* Responsive Styles for navigation */
@media (max-width: 768px) {
    .nav {
        flex-direction: column;
        align-items: flex-start;
    }

    .nav li {
        display: block;
    }

    .nav a {
        padding: 5px 0;
    }
}
		
    </style>
