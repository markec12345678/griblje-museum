<style>
    html, body {
        height: 100%;
        margin: 0;
    }

    #tify {
        height: 100vh;
        width: 100vw;
    }

</style>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tify@0.35.0/dist/tify.css?0.35.0">

<body>
<div id="tify"></div>

<script type="module">
    import Tify from 'https://cdn.jsdelivr.net/npm/tify@0.35.0/dist/tify.js?0.35.0';

    const params = new URLSearchParams(location.search);

    const uodid = params.get('uodid');
    const docid = params.get('docid');
    const seq   = params.get('seq');
    const type  = params.get('type'); // "pdf" ali null

    let manifestUrl = null;

    // 1) Novi "čisti" način
    if (uodid && docid) {
        if (type === 'pdf') {
            manifestUrl = `${location.origin}/vac/iiif/pdf-manifest?uodid=${encodeURIComponent(uodid)}&docid=${encodeURIComponent(docid)}`;
        } else if (type === 'image') {
            manifestUrl = `${location.origin}/vac/iiif/file-manifest?uodid=${encodeURIComponent(uodid)}&docid=${encodeURIComponent(docid)}`;
        } else if (seq) {
            manifestUrl = `${location.origin}/vac/iiif/manifest?uodid=${encodeURIComponent(uodid)}&docid=${encodeURIComponent(docid)}&seq=${encodeURIComponent(seq)}`;
        } else {
            document.body.innerHTML =
                '<pre style="padding:16px">Manjka seq (za sliko) ali type=pdf (za PDF).</pre>';
            throw new Error('Missing seq or type');
        }
    }
    // 2) Backward compatible: stari način manifest=...
    else {
        const raw = params.get('manifest');
        if (!raw) {
            document.body.innerHTML = '<pre style="padding:16px">Manjka parameter ?uodid=&docid=&seq= ali ?type=pdf ali ?manifest=...</pre>';
            throw new Error('Missing params');
        }

        // URLSearchParams already decoded the outer parameter. Keep filenames inside it encoded.
        manifestUrl = new URL(raw, location.origin).href;
    }

    new Tify({
        container: '#tify',
        manifestUrl: manifestUrl,
        language: 'sl',
        translationsDirUrl: '/i18n',
        annotationsVisible: true,
        viewer: {
            maxZoomPixelRatio: 4,
            imageLoaderLimit: 2,
            immediateRender: false,
            blendTime: 0.15,
        },
    });

    // Zagotovimo, da so slike zaznavne tudi, če jih pregledovalnik ustvari brez alt atributa.
    let accessibilityFrame = null;
    const imageObserver = new MutationObserver(function () {
        if (accessibilityFrame !== null) return;
        accessibilityFrame = requestAnimationFrame(function () {
            accessibilityFrame = null;
            document.querySelectorAll('#tify img:not([alt])').forEach(function (image) {
                image.setAttribute('alt', 'Slika');
            });
            document.querySelectorAll('#tify canvas').forEach(function (canvas) {
                canvas.setAttribute('role', 'img');
                canvas.setAttribute('aria-label', canvas.getAttribute('aria-label') || 'Slika');
            });
            localizeTifyControls();
        });
    });
    imageObserver.observe(document.getElementById('tify'), {
        childList: true,
        subtree: true,
        attributes: false
    });

    function localizeTifyControls() {
        const translations = {
            'Export': 'Izvoz',
            'Current page': 'Trenutna stran',
            'Current Page': 'Trenutna stran',
            'Download Individual Images': 'Prenesi posamezne slike',
            'Download individual images': 'Prenesi posamezne slike',
            'Fulltext': 'Besedilo',
            'Full text': 'Besedilo',
            'Fulltext [noun]': 'Besedilo',
            'View': 'Pogled',
            'View [noun]': 'Pogled'
        };

        document.querySelectorAll('#tify *').forEach(function (element) {
            ['aria-label', 'title'].forEach(function (attribute) {
                const value = element.getAttribute(attribute);
                if (value && translations[value] && value !== translations[value]) {
                    element.setAttribute(attribute, translations[value]);
                }
            });

            if (element.children.length === 0) {
                const value = element.textContent.trim();
                if (translations[value] && value !== translations[value]) {
                    element.textContent = translations[value];
                }
            }
        });
    }

    localizeTifyControls();
    window.addEventListener('pagehide', function () {
        imageObserver.disconnect();
        if (accessibilityFrame !== null) cancelAnimationFrame(accessibilityFrame);
    });
</script>


</body>
</html>
