/*<![CDATA[*/
var rootId = 1000001;
var rootText = "Vzajemna podatkovna zbirka slovenskih arhivov";
var rootType = 17;
var filterId = null;
var filterText = null;
var filterType = null;
var loadingText = "Nalagam...";
var addToWorkbookSuccess = "Izbrani rezultati so shranjeni.";
var noItemSelected = "Izbrati morate popisno enoto.";
var noFilterSet = "Ni nastavljene omejitve.";
var msgArchPlanLimit = "Iskana PE je pregloboko v tektoniki in je na ta na\u010Din ni mo\u017Eno prikazati!";
var workbookDialog = $("#addToWorkbookDialog");
var workbooks = $("#workbooks");
var newWorkbookName = $("#newWorkbookName");

var isDoubleClicked = false;

function filter(domObject) {
    var id = $("#archivePlanTree").jstree("get_selected");
    if(id == "") {
        dialog(noItemSelected, null, null, null, null, false, false, true, false);
        return;
    }

    var text = $('#archivePlanTree').jstree(true).get_node(id).text;
    var type = $('#archivePlanTree').jstree(true).get_node(id).type;

    inProgress(true);
    try {
        $.ajax({ // Send request
            type: "post",
            url: "/vac/search/archivePlanFilterAjax?id=" + id + "&type=" + type,
            contentType : 'application/json; charset=utf-8',
            dataType : 'json',
            data : text,
            success: function(response) {
                initTree(id, text, type, loadingText, true);
                filterId = id;
                inProgress(false);
            },
            error: handleAjaxError
        });
    }
    catch(err) {
        inProgress(false);
    }
}

function filterCancel(domObject) {
    if(filterId == null) {
        dialog(noFilterSet, null, null, null, null, false, false, true, false);
        return;
    }
    inProgress(true);
    try {
        $.ajax({ // Send request
            type: "post",
            url: "/vac/search/archivePlanFilterAjax?id=-1&type=-1",
            contentType : 'application/json; charset=utf-8',
            dataType : 'json',
            data : JSON.stringify(""),
            success: function(response) {
                initTree(rootId, rootText, rootType, loadingText, true);
                filterId = null;
                inProgress(false);
            },
            error: handleAjaxError
        });
    }
    catch(err) {
        inProgress(false);
    }
}

function details(domObject) {
    var id = $("#archivePlanTree").jstree("get_selected");
    if(id == "") {
        dialog(noItemSelected, null, null, null, null, false, false, true, false);
        return;
    }
    if(String(id).indexOf("+") !== -1 || String(id).indexOf("-") !== -1) {
        // First/previous/next/last page selected. Cancel.
        return;
    }
    inProgress(true);
    location.href = "details?id=" + id + "&text=" + encodeURIComponent($('#archivePlanTree').jstree(true).get_node(id).text);
}

function toPdf() {
    /*var doc = new jsPDF();
    doc.fromHTML($("#archivePlanTree").get(0), 20, 20, { width:500,lang:'sl' });
    doc.save("Test.pdf");*/
    window.print();
}

function addToWorkbook() {
    if(workbooks.val() <= 0 && newWorkbookName.val().trim() === "") {
        return;
    }
    
    workbookDialog.hide();
    workbookDialog.attr("aria-hidden",true);
    inProgress(true);
    try {
        var ids = $("#archivePlanTree").jstree("get_selected");
        
        $.ajax({
            type: "post",
            url: "/vac/search/addToWorkbookAjax?id=" + workbooks.val() + "&name=" + newWorkbookName.val(),
            contentType : 'application/json; charset=utf-8',
            dataType : 'json',
            data : JSON.stringify(ids),
            success: function(response){
                if(!response.error) {
                    inProgress(false);
                    dialog(addToWorkbookSuccess, null, null, null, null, false, false, true, false);
                }
                else {
                    inProgress(false);
                    dialog(response.errorDescription, null, null, null, null, false, false, true, false);
                }

                if(response.id > 0) {
                    workbooks.append(new Option(newWorkbookName.val(), response.id));
                }
                workbooks.val(0);
                newWorkbookName.val("");
                
                return false;
            },
            error: handleAjaxError
        });
    }
    catch(err) {
        inProgress(false);
    }
}

function chooseWorkbook() {
    var id = $("#archivePlanTree").jstree("get_selected");
    if(id == "") {
        dialog(noItemSelected, null, null, null, null, false, false, true, false);
        return;
    }
    
    workbookDialog.show();
    workbookDialog.attr("aria-hidden",false);
    positionOnCenter(workbookDialog);
}

$(window).resize(function() {
    positionOnCenter(workbookDialog);
});

$(function () {
    if(filterId == null) {
        initTree(rootId, rootText, rootType, loadingText, false);
    }
    else {
        initTree(filterId, filterText, filterType, loadingText, false);
    }
});

function initTree(rootId, rootText, rootType, loadingText, reinit) {
    if(reinit) {
        $("#archivePlanTree").jstree('destroy');
    }
    $('#archivePlanTree').jstree({
        "plugins" : ["types"],
        'core': {
            'dblclick_toggle' : false,
            'data': [{
                "id": rootId,
                "text": rootText,
                "type": rootType,
                "data":"0", //page_index
                "state": {
                "opened": false,
                "selected":false
                },
                "children": [{
                    "id": rootId + "_dummy",
                    "text": loadingText,
                    "type": 0
                }]
            }],
            'check_callback': true
        },
        "types" : {
            "pgUp" : { "icon" : "jstree-icon-pgUp" },
            "pgDown" : { "icon" : "jstree-icon-pgDown" },
            "0" : { "icon" : "jstree-icon-0" },
            "1" : { "icon" : "jstree-icon-1" },
            "2" : { "icon" : "jstree-icon-2" },
            "3" : { "icon" : "jstree-icon-3" },
            "4" : { "icon" : "jstree-icon-4" },
            "5" : { "icon" : "jstree-icon-5" },
            "6" : { "icon" : "jstree-icon-6" },
            "7" : { "icon" : "jstree-icon-7" },
            "8" : { "icon" : "jstree-icon-8" },
            "9" : { "icon" : "jstree-icon-9" },
            "10" : { "icon" : "jstree-icon-10" },
            "11" : { "icon" : "jstree-icon-11" },
            "12" : { "icon" : "jstree-icon-12" },
            "13" : { "icon" : "jstree-icon-13" },
            "14" : { "icon" : "jstree-icon-14" },
            "15" : { "icon" : "jstree-icon-15" },
            "16" : { "icon" : "jstree-icon-16" },
            "17" : { "icon" : "jstree-icon-17" },
            "18" : { "icon" : "jstree-icon-18" },
            "19" : { "icon" : "jstree-icon-19" },
            "20" : { "icon" : "jstree-icon-20" },
            "21" : { "icon" : "jstree-icon-21" },
            "22" : { "icon" : "jstree-icon-22" },
            "23" : { "icon" : "jstree-icon-23" },
            "24" : { "icon" : "jstree-icon-24" }
        }            
    })
    .on('before_open.jstree', function(e, data) {
        isDoubleClicked = false;
        replaceAndAddChildren(data.node);
    })
    .on('loaded.jstree', function(e, data) {
        var url = new URL(window.location);
        var path = url.searchParams.get("path");
        if(path != null) {
            ids = path.split(',');
            expandNext();
        }
    });
}

var ids = null;
var idsIndex = -1;
var idsPage = 0;

function expandNext() {
    idsIndex++;
    if(ids != null && idsIndex < ids.length) {
        //$("#archivePlanTree").jstree(true).select_node(ids[idsIndex]);
        $("#" + ids[idsIndex] + "_anchor").focus();
        if ($("#archivePlanTree").jstree(true).get_node(ids[idsIndex], true) == false) {
            // Item not found. Check if "Next 100" exists and click it.
            idsIndex--;
            idsPage++;
            var idsNextPageId = ids[idsIndex] + "+" + idsPage;
            if ($("#archivePlanTree").jstree(true).get_node(idsNextPageId, true) == false) {
                dialog(msgArchPlanLimit, null, null, null, null, false, false, true, false);
            }
            $("#archivePlanTree").jstree(true).open_node(idsNextPageId);
            return;
        }
        $("#archivePlanTree").jstree(true).open_node(ids[idsIndex]);
    }
}

function replaceAndAddChildren(node) {
    //if(working) return false;
    try {
        var id = String(node.id);
        var dummyChild = $('#archivePlanTree').jstree(true).get_node(id + "_dummy", true);
        var pageChange = false;
        var pageIndex = 0;
        var moveForward = false;
        if(id.indexOf("--") !== -1) { // goto first page
            pageIndex = 0;
            id = id.replace("--", "");
            pageChange = true;
        }
        else if(id.indexOf("-") !== -1) { // goto previous page
            var parts = id.split("-");
            id = parts[0];
            pageIndex = parseInt(parts[1]);
            pageChange = true;
        }
        else if(id.indexOf("++") !== -1) { // goto next page
            var parts = id.split("++");
            id = parts[0];
            pageIndex = parseInt(parts[1]);
            pageChange = true;
            moveForward = true;
        }
        else if(id.indexOf("+") !== -1) { // goto last page
            var parts = id.split("+");
            id = parts[0];
            pageIndex = parseInt(parts[1]);
            pageChange = true;
            moveForward = true;
        }
        else if(dummyChild[0] == null) {
            return;
        }

        inProgress(true);
        $("#archivePlanTree").jstree(true).delete_node(dummyChild);
        inProgress(true);

        // Add waiting class to the node.
        $('#archivePlanTree').jstree(true).get_node(id, true).addClass("jstree-loading");
    
        replaceAndAddChildrenWithDelay(node, dummyChild, pageChange, id, pageIndex, moveForward);
    }
    catch(err) {
        inProgress(false);
    }
}

function replaceAndAddChildrenWithDelay(node, dummyChild, pageChange, id, pageIndex, moveForward) {
    try {
        var href = "/vac/search/archivePlanSearchAjax?id=" + id + "&page=" + pageIndex;
        
        $.ajax({ // Send request
            type: "get",
            url: href,
            success: function(response) {
                if(pageChange) {
                    id = node.parent;
                    var parentNode = $('#archivePlanTree').jstree(true).get_node(id);
                    // Clear children
                    parentNode.children = [];
                }
                var lastNode = null;
                for(var i = 0; i < response.length; i++) {
                    var newNode = response[i];
                    lastNode = newNode;
                    $('#archivePlanTree').jstree('create_node', $("#" + id), newNode, "last", null, false);
                }
                inProgress(false);
                if(lastNode != null && moveForward) {
                    $("#archivePlanTree").jstree(true).get_node(lastNode.id, true).children('.jstree-anchor').focus();
                }

                var nodeAsDom = $('#archivePlanTree').jstree(true).get_node(id, true);
                if($(nodeAsDom).hasClass("jstree-loading")) {
                    $(nodeAsDom).removeClass("jstree-loading");
                }
                //$("#archivePlanTree").jstree(true).select_node(node.parent);

                expandNext();
            },
            error: handleAjaxError
        });
    }
    catch(err) {
        inProgress(false);
    }
}

$('#archivePlanTree').on("dblclick", function (e) {
    nodeSelected(e);
});

$('#archivePlanTree').on("keydown", function (e) {
    if (e.keyCode == 13) {
        nodeSelected(e);
    }
});

var selectedNodeId;
function nodeSelected(e) {
    try {
        isDoubleClicked = true;
        // Check if clicked item is not plus icon (I).
        if(e.target.tagName.toUpperCase() != "I") {
            var li = $(e.target).closest("li");
    
            // Deselect node if page is activated using history.back from the UoD details page.
            selectedNodeId = li[0].id;

            if(String(selectedNodeId).indexOf("+") !== -1 || String(selectedNodeId).indexOf("-") !== -1) {
                // First/previous/next/last page selected. Cancel.
                isDoubleClicked = false;

                // expand children
                //replaceAndAddChildren(li[0]);
                
                return;
            }

            inProgress(true);
            location.href = "details?id=" + selectedNodeId + "&text=" + encodeURIComponent($('#archivePlanTree').jstree(true).get_node(selectedNodeId).text);
        }
    }
    catch(err) {
        inProgress(false);
    }
}

// reset cursor to default when page is activated (on history.back).
visibilityHandler(function(){
    if(visibilityHandler()) {
        inProgress(false);
        $('#archivePlanTree').jstree(true).deselect_node(selectedNodeId);
    };
});

