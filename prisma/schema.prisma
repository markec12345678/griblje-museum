generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Muzej vasi Griblje — shema digitalne muzejske zbirke.
// Vsak zapis nosi evidence status; viri so ločeni entitete z licencami.

model Exhibit {
  id            String   @id @default(uuid())
  slug          String   @unique
  category      String // kraj | kolpa | vojna | narava | gospodarstvo | sege
  titleSi       String
  titleEn       String
  periodSi      String
  periodEn      String
  summarySi     String
  summaryEn     String
  storySi       String
  storyEn       String
  evidenceStatus String // DOCUMENTED | CORROBORATED | TESTIMONY | TRADITION | UNVERIFIED | TO_COLLECT
  image         String?
  imageCredit   String? // navedba fotografije: avtor, Wikimedia Commons, licenca
  lat           Float?
  lng           Float?
  coordsApprox  Boolean  @default(false)
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sources       Source[]

  @@index([category])
  @@index([evidenceStatus])
}

model Source {
  id         String   @id @default(uuid())
  exhibitId  String
  exhibit    Exhibit  @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  nameSi     String
  nameEn     String
  sourceType String // arhiv | fotografija | objava | spletni-vir | pricevanje | zemljevid
  license    String
  url        String?
  noteSi     String?
  noteEn     String?
  sortOrder  Int      @default(0)

  @@index([exhibitId])
}

model StoryItem {
  id             String  @id @default(uuid())
  kind           String // ZGODBA | NACELO | RAZPIS
  titleSi        String
  titleEn        String
  textSi         String
  textEn         String
  attributionSi  String?
  attributionEn  String?
  evidenceStatus String
  sortOrder      Int     @default(0)

  @@index([kind])
}

model MuseumEvent {
  id            String   @id @default(uuid())
  titleSi       String
  titleEn       String
  descriptionSi String
  descriptionEn String
  startsAt      DateTime
  locationSi    String
  locationEn    String
  eventType     String // PRIREDITEV | DELAVNICA | VODENJE
  isExternal    Boolean  @default(false)
  externalUrl   String?
}
