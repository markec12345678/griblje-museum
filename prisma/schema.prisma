generator client {
  provider        = "prisma-client-js"
  // "native" za razvoj; rhel-openssl-3.0.x pokriva sliko gradnje/izvajanja
  // na Vercelu (Amazon Linux 2023).
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Direkt endpoint za migracije in shadow DB (Neon); DATABASE_URL je pooled
  // (PgBouncer) za aplikacijski runtime. Glej docs/DEPLOYMENT.md (issue #27/A1).
  directUrl = env("DIRECT_URL")
}

// Muzej vasi Griblje — shema digitalne muzejske zbirke.
// Vsak zapis nosi evidence status; viri so ločeni entitete z licencami.

model Exhibit {
  id            String   @id @default(uuid())
  slug          String   @unique
  /** Trajna muzejska številka (inventarna, npr. MVG-001) — vzorec
   * objektnih številk Rijksmuseuma / UPI DigitaltMuseum. Enkrat dodeljena
   * se ne spreminja; novi zapisi prejmejo naslednjo številko v vrsti. */
  museumNo      String?  @unique
  category      String // kraj | kolpa | vojna | narava | gospodarstvo | sege
  titleSi       String
  titleEn       String
  periodSi      String
  periodEn      String
  summarySi     String
  summaryEn     String
  storySi       String
  storyEn       String
  evidenceStatus String // DOCUMENTED | CORROBORATED | TESTIMONY | TRADITION | UNVERIFIED | TO_COLLECT
  image         String?
  imageCredit   String? // navedba fotografije: avtor, Wikimedia Commons, licenca
  /** 3D-model zapisa (GLB; prim. tudi .usdz za AR na iOS) — digitalizacija
   *  enot kulturne dediščine po merilih razpisov (MGTŠ/Interreg). */
  model3dUrl     String?
  model3dCredit  String? // avtorstvo/kontekst 3D-modela (npr. interpretativni model muzeja)
  yearFrom      Int?     // strukturirana datacija (po vzoru DigitaltMuseum fdate): začetno leto; null = nedatiran tok
  yearTo        Int?     // končno leto; null = teče do danes
  lat           Float?
  lng           Float?
  coordsApprox  Boolean  @default(false)
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  /** Kurirani datum vključitve zapisa v zbirko (po vzoru DigitaltMuseum „registrert“). */
  addedAt       DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sources       Source[]
  memories      ObjectMemory[]
  assets        DigitalAsset[]

  @@index([category])
  @@index([evidenceStatus])
  @@index([museumNo])
}

// --- Digital asset management (issue #27/B) ------------------------------
// Centralni register digitalnih vsebin: fotografije, skeni, PDF, audio,
// video, GLB/USDZ, IIIF derivati, sličice. Velikih binarnih vsebin NE
// shranjujemo v bazi — samo ključ objekta (storageKey) + metapodatki.
//
// Načela (acceptance criteria #27/B):
//   - original in derivat sta ločena zapisa, povezana z derivedFromId;
//   - vsak asset nosi SHA-256 povzetek vsebine (identiteta bitov);
//   - vsak asset nosi pravice (copyright, licenca, URL licence, atribucija);
//   - zasebni asset (accessLevel != PUBLIC) ni javno servisiran brez
//     avtorizacije (glej /api/assets — filter je obvezen);
//   - zamenjava ne briše zgodovine: nov zapis prevzame rolo in staremu
//     nastavi preservationStatus = REPLACED + replacedById.

model DigitalAsset {
  id               String   @id @default(uuid())
  /** Ključ objekta v hranilniku (S3/R2/disk) — nikoli binarna vsebina. */
  storageKey       String   @unique
  mime             String
  originalFilename String
  bytes            Int
  width            Int?
  height           Int?
  /** SHA-256 vsebine, izračunan ob vnosu (scripts/asset-register.ts).
   * Enak checksum na več zapisih = znana duplikacija, ne napaka —
   * deduplikacija je odločitev registra, ne sheme. */
  sha256           String
  creator          String?
  copyrightHolder  String
  license          String
  licenseUrl       String?
  attribution      String?
  /** Izvor vsebine (arhiv, fotograf, donator …) — prosto besedilo. */
  origin           String?
  /** fotografija | sken | pdf | audio | video | glb | usdz | iiif-derivative | thumbnail */
  kind             String
  /** ACTIVE | MIGRATED | DEGRADED | REPLACED | LOST (preservacija #27/N). */
  preservationStatus String @default("ACTIVE")
  /** PUBLIC | RESTRICTED | INTERNAL — javni klici smejo videti samo PUBLIC. */
  accessLevel      String   @default("PUBLIC")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exhibitId String?
  exhibit   Exhibit? @relation(fields: [exhibitId], references: [id], onDelete: SetNull)

  /** Derivacijska veriga: IIIF derivati, sličice, konverzije. */
  derivedFromId String?
  derivedFrom   DigitalAsset?  @relation("AssetDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives   DigitalAsset[] @relation("AssetDerivation")

  /** Zamenjava: stari zapis ostane (zgodovina), kaže na naslednika. */
  replacedById String?
  replacedBy   DigitalAsset?  @relation("AssetReplacement", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     DigitalAsset[] @relation("AssetReplacement")

  @@index([exhibitId])
  @@index([kind])
  @@index([accessLevel])
  @@index([sha256])
  @@index([preservationStatus])
}

model Source {
  id         String   @id @default(uuid())
  exhibitId  String
  exhibit    Exhibit  @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  nameSi     String
  nameEn     String
  sourceType String // arhiv | fotografija | objava | spletni-vir | pricevanje | zemljevid
  license    String
  url        String?
  noteSi     String?
  noteEn     String?
  sortOrder  Int      @default(0)

  @@index([exhibitId])
}

model StoryItem {
  id             String  @id @default(uuid())
  kind           String // ZGODBA | NACELO | RAZPIS
  titleSi        String
  titleEn        String
  textSi         String
  textEn         String
  attributionSi  String?
  attributionEn  String?
  evidenceStatus String
  sortOrder      Int     @default(0)

  @@index([kind])
}

model MuseumEvent {
  id            String   @id @default(uuid())
  titleSi       String
  titleEn       String
  descriptionSi String
  descriptionEn String
  startsAt      DateTime
  locationSi    String
  locationEn    String
  eventType     String // PRIREDITEV | DELAVNICA | VODENJE
  isExternal    Boolean  @default(false)
  externalUrl   String?
}

// --- Sodelovanje skupnosti (vzorec: DigitaltMuseum, Tenement Museum) ---
// Prispevki obiskovalcev. Status:
//   published — viden vsem (samodejno objavljen čisti besedili brez povezav)
//   held      — čaka na kurotorski pregled (vsebuje povezavo/e-pošto/oznake)
// Honeypot polje `website` se ne shranjuje — tiho zavrženo (spam past).

model GuestbookEntry {
  id        String   @id @default(uuid())
  name      String // ime ali vzdevek obiskovalca
  place     String? // kraj, odkod obiskovalec piše
  message   String // besedilo v spominski knjigi
  lang      String   @default("sl") // jezik, v katerem obiskovalec piše
  status    String   @default("published")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

model ObjectMemory {
  id        String   @id @default(uuid())
  exhibitId String
  exhibit   Exhibit  @relation(fields: [exhibitId], references: [id], onDelete: Cascade)
  author    String // ime ali vzdevek pripovedovalca
  place     String? // kraj, odkod piše (npr. Črnomelj, Cleveland, Sydney)
  memory    String // osebni spomin, povezan s predmetom
  lang      String   @default("sl")
  status    String   @default("published")
  createdAt DateTime @default(now())

  @@index([exhibitId, status])
  @@index([status, createdAt])
}

// --- Statistika obiska (priprava na razpisna poročila: spremljanje in
// vrednotenje doseganja ciljev — zahteva 1.18 razpisne dokumentacije MGTŠ) ---
// Zasebno-primerljivi zbirni števci: brez piškotkov, brez IP-jev, brez
// identifikatorjev naprav — štejejo se samo (dan, vrsta, jezik, ključ)
// in kumulativno število. Dan je strežniški lokalni datum (Europe/Ljubljana).
model StatDay {
  id        String   @id @default(uuid())
  day       String // YYYY-MM-DD
  kind      String // visit | open | walk | guide | curator | audio | ar | download
  lang      String // sl | en | hr | de | it ( jeziki vmesnika)
  key       String   @default("") // slug zapisa / id sprehoda / "" za splošno
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, kind, lang, key])
  @@index([day, kind])
  @@index([kind, key])
}
